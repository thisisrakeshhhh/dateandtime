# ==============================================================================
# TimeBridge Environment Configuration Template
# Copy this file to .env.local for local development, or set in Vercel Project Settings.
# ==============================================================================

# [Required in Production] Canonical production site URL without trailing slash (e.g. https://yourdomain.com)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# [Optional] Operator or owner name displayed on the About page (defaults to "an independent developer" if unset)
NEXT_PUBLIC_OWNER_NAME=

# [Required for Contact Form] Destination email address where contact messages are delivered
CONTACT_EMAIL=support@yourdomain.com

# [Required for Contact Form] Resend transactional email API key (starts with re_)
RESEND_API_KEY=

# [Optional] Verified sender address in Resend (defaults to onboarding@resend.dev during testing)
RESEND_FROM_EMAIL=onboarding@resend.dev

# [Optional] Phased sitemap indexing wave (1 = Tier 1 Corridors/Converters, 2 = Cities, 3 = Countries & DST; defaults to 1)
INDEX_WAVE=1

# [Optional] Master toggle to render Google AdSense units ("true" or "false"; defaults to false until approved)
NEXT_PUBLIC_ENABLE_ADS=false

# [Optional] Google AdSense publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX; leave empty until approved)
NEXT_PUBLIC_ADSENSE_CLIENT=

# [Optional] Google AdSense slot ID for the top banner ad unit
NEXT_PUBLIC_ADSENSE_SLOT_TOP=

# [Optional] Google AdSense slot ID for the bottom / in-content ad unit
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=

# [Optional] Commercial weather data provider API key (if using a third-party weather API)
WEATHER_API_KEY=

# [Optional] Commercial license API key for Open-Meteo (omits Open-Meteo credit if unset)
OPENMETEO_COMMERCIAL_KEY=

# [Optional] Explicit opt-in flag to use non-commercial Open-Meteo endpoints ("true" or "false"; defaults to false)
ENABLE_NONCOMMERCIAL_OPENMETEO=false
